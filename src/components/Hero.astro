---
---
<section class="gym-hero">
  <div class="gym-content">
    <div class="accent-line"></div>
    <span class="badge">Entrenador Certificado · +6 años de experiencia</span>
    <h1 class="headline">
      TRANSFORMA<br>
      TU <span class="gold">CUERPO.</span><br>
      PARA SIEMPRE.
    </h1>
    <p class="subline">Entrenamiento personalizado · Resultados garantizados</p>
    <div class="stats-row">
      <div class="stat-item">
        <span class="stat-num">6+</span>
        <span class="stat-label">Años como entrenador</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">10+</span>
        <span class="stat-label">Años entrenando</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">100%</span>
        <span class="stat-label">Resultados garantizados</span>
      </div>
    </div>
    <div class="divider"></div>
    <div class="ctas">
      <a href="#encuesta" class="btn-fire">Quiero empezar ↗</a>
      <a href="#planes" class="btn-ghost">Ver planes</a>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700&family=Barlow:wght@300;400&display=swap');

  .gym-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    font-family: 'Barlow', sans-serif;
    background: url('/img/4.png') center top / cover no-repeat;
  }
  .gym-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(8,8,8,0.97) 0%,
      rgba(8,8,8,0.90) 45%,
      rgba(8,8,8,0.50) 75%,
      rgba(8,8,8,0.20) 100%
    );
    z-index: 1;
  }
  .gym-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 580px;
    padding: clamp(48px, 10vw, 80px) clamp(20px, 6vw, 60px);
  }
  .accent-line {
    width: 32px;
    height: 3px;
    background: #e5c178;
    margin-bottom: 16px;
  }
  .badge {
    display: inline-block;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(9px, 2.5vw, 11px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #e5c178;
    border: 1px solid rgba(229,193,120,0.4);
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  .headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 12vw, 76px);
    line-height: 0.92;
    color: #fff;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
  }
  .headline .gold { color: #e5c178; }
  .subline {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(10px, 2.5vw, 11px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 28px;
  }
  .stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 28px;
    border-left: 2px solid #e5c178;
  }
  .stat-item {
    padding: 6px 16px 6px 16px;
    border-right: 1px solid rgba(255,255,255,0.07);
  }
  .stat-item:last-child { border-right: none; }
  .stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(26px, 7vw, 34px);
    color: #e5c178;
    line-height: 1;
    display: block;
  }
  .stat-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(8px, 2vw, 9px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    display: block;
    margin-top: 2px;
    max-width: 72px;
    line-height: 1.3;
  }
  .divider {
    width: 100%;
    height: 1px;
    background: rgba(255,255,255,0.06);
    margin-bottom: 24px;
  }
  .ctas {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn-fire {
    background: #e5c178;
    color: #080808;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(12px, 3vw, 13px);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 13px 28px;
    border: none;
    cursor: pointer;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 100%, 10px 100%);
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.2s;
  }
  .btn-fire:hover { opacity: 0.85; }
  .btn-ghost {
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.55);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(11px, 2.5vw, 12px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 12px 22px;
    background: transparent;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s;
  }
  .btn-ghost:hover { border-color: rgba(255,255,255,0.5); color: #fff; }

  @media (max-width: 480px) {
    .gym-hero::before {
      background: rgba(8,8,8,0.88);
    }
    .ctas { flex-direction: column; align-items: flex-start; }
    .btn-fire, .btn-ghost { width: 100%; text-align: center; }
  }
</style>