---
---

<section style="
  position: relative;
  width: 100%;
  min-height: 100vh;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: clamp(32px, 5vw, 64px) clamp(24px, 6vw, 96px);
  overflow: hidden;
">

  <!-- rings -->
  <div style="position:absolute;top:-80px;right:-80px;width:500px;height:500px;border-radius:50%;border:1px solid rgba(229,193,120,0.1);pointer-events:none;"></div>
  <div style="position:absolute;top:60px;right:0px;width:280px;height:280px;border-radius:50%;border:1px solid rgba(229,193,120,0.06);pointer-events:none;"></div>
  <div style="position:absolute;bottom:-40px;left:-80px;width:320px;height:320px;border-radius:50%;border:1px solid rgba(229,193,120,0.07);pointer-events:none;"></div>

  <!-- badge -->
  <div>
    <span style="
      display: inline-block;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #e5c178;
      border: 1px solid rgba(229,193,120,0.4);
      padding: 6px 16px;
      border-radius: 999px;
    ">
      Entrenador Certificado · +6 años de experiencia
    </span>
  </div>

  <!-- headline block -->
  <div style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:32px 0;">
    <h1 style="
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(68px, 14vw, 160px);
      line-height: 0.92;
      color: #fff;
      letter-spacing: 0.01em;
    ">
      TRANSFORMA<br />
      TU <span style="color:#e5c178;">CUERPO.</span><br />
      PARA SIEMPRE.
    </h1>

    <p style="
      font-size: clamp(11px, 1.2vw, 13px);
      font-weight: 300;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-top: 24px;
    ">
      Entrenamiento personalizado · Resultados garantizados
    </p>

    <!-- stats -->
    <div style="display:flex;gap:clamp(24px,5vw,56px);margin-top:clamp(28px,4vw,44px);">
      <div>
        <p style="font-family:'Bebas Neue',sans-serif;font-size:clamp(34px,5vw,48px);color:#e5c178;line-height:1;">6+</p>
        <p style="font-size:10px;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Años entrenando</p>
      </div>
      <div>
        <p style="font-family:'Bebas Neue',sans-serif;font-size:clamp(34px,5vw,48px);color:#e5c178;line-height:1;">100%</p>
        <p style="font-size:10px;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Resultados reales</p>
      </div>
      <div>
        <p style="font-family:'Bebas Neue',sans-serif;font-size:clamp(34px,5vw,48px);color:#e5c178;line-height:1;">3–5</p>
        <p style="font-size:10px;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.1em;margin-top:4px;">Días / semana</p>
      </div>
    </div>
  </div>

  <!-- ctas -->
  <div style="display:flex;gap:12px;flex-wrap:wrap;">
    <a href="#encuesta" style="
      background:#e5c178;color:#0a0a0a;
      font-size:14px;font-weight:500;font-family:'DM Sans',sans-serif;
      letter-spacing:0.04em;padding:14px 28px;
      border-radius:3px;text-decoration:none;
      transition:opacity 0.15s;display:inline-block;
    " onmouseover="this.style.opacity='0.82'" onmouseout="this.style.opacity='1'">
      Quiero empezar ↗
    </a>
    <a href="#planes" style="
      background:transparent;color:rgba(255,255,255,0.65);
      border:1px solid rgba(255,255,255,0.22);
      font-size:14px;font-family:'DM Sans',sans-serif;
      padding:14px 24px;border-radius:3px;text-decoration:none;
      transition:all 0.15s;display:inline-block;
    " onmouseover="this.style.borderColor='rgba(255,255,255,0.55)';this.style.color='#fff'" onmouseout="this.style.borderColor='rgba(255,255,255,0.22)';this.style.color='rgba(255,255,255,0.65)'">
      Ver planes
    </a>
  </div>

</section>
