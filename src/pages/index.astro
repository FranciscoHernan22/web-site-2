---
import Layout from "../layouts/Layout.astro";

const stats = [
  { num: "✓", label: "Sin experiencia previa necesaria" },
  { num: "100+", label: "Clientes satisfechos" },
  { num: "★", label: "Acompañamiento real" },
  { num: "6+", label: "Años de experiencia" },
];

const beneficios = [
  { titulo: "Viví lo que te voy a enseñar", texto: "Entré al gym a los 16. A los 18 ya había transformado mi cuerpo con pesas. Antes de mi primer cliente me capacité en fisiología articular y metodología del entrenamiento — la base de todo lo que hago." },
  { titulo: "Trabajo con tu cuerpo, no contra él", texto: "He guiado a principiantes absolutos. Mi conocimiento en fisiología articular me deja diseñar entrenamientos seguros que sí progresan." },
  { titulo: "Primero aprendes, luego dominas", texto: "Si eres nuevo, mi prioridad es que ejecutes cada ejercicio correcto y seguro. Te enseño bien desde el principio para que después entrenes con autonomía y confianza." },
  { titulo: "Un plan que nunca se detiene", texto: "Mes a mes cambio ejercicios y método. El cuerpo necesita nuevos estímulos para seguir respondiendo — no hay estancamiento cuando hay planificación." },
];

const etapas = [
  { icon: "ti-shield-check", mes: "Mes 1 · Empiezas sin miedo", titulo: "Aprendes a hacerlo bien", texto: "Nunca estás perdido frente a una máquina. La app te muestra videos y fotos guía de cada ejercicio, y yo te corrijo antes de que el error se vuelva hábito.", fill: false },
  { icon: "ti-chart-line", mes: "Mes 3–6 · Ves tus números subir", titulo: "El progreso deja de ser una sensación", texto: "Registras tus pesos en la app y ves con números cómo avanzas. Cada mes cambio tu plan para que nunca te estanques.", fill: false },
  { icon: "ti-flame", mes: "Mes 12 · Entrenas como avanzado", titulo: "Mueves cargas que hoy ni imaginas", texto: "El que llegó sin saber nada ahora entrena intenso, con técnica sólida y un físico que cambió de verdad. No es suerte: es un año de método.", fill: true },
];

const testimonios = [
  { texto: "Nunca había pisado un gym y me daba pena no saber qué hacer. En un año subí 6 kilos de músculo y ahora entreno con confianza. La app fue clave: siempre sabía cómo hacer cada ejercicio.", nombre: "Carlos M.", edad: "42 años", tiempo: "Cliente 1 año", ini: "CM" },
  { texto: "Llegué con una hernia y miedo a lesionarme más. Francisco armó un plan que cuidó mi espalda desde el día uno. Hoy estoy más fuerte que a los 30, sin un solo dolor.", nombre: "Adriana R.", edad: "48 años", tiempo: "Cliente 8 meses", ini: "AR" },
  { texto: "Lo que más valoro es que el plan cambia cada mes y nunca me estanco. No es un PDF genérico, es alguien que ve mis números y ajusta. Vale cada peso.", nombre: "Jorge T.", edad: "36 años", tiempo: "Cliente 6 meses", ini: "JT" },
];

const features = [
  "Plan personalizado a tu cuerpo, tu edad y tu condición",
  "App con videos y fotos guía de cada ejercicio",
  "Registro de pesos para ver tu progreso real",
  "Plan nuevo cada mes · nunca te estancas",
  "Seguimiento por mensajería · nunca entrenas solo",
];

const whatsapp = "526242404890"; // ← cambia por tu número real
const mensaje = encodeURIComponent("Hola Francisco, quiero empezar mi asesoría. ¿Cómo empezamos?");
const waLink = `https://wa.me/${whatsapp}?text=${mensaje}`;
---

<Layout title="FH Performance · Asesoría profesional en entrenamiento y salud">

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <div class="logo"><i class="ti ti-flame"></i><span>FH PERFORMANCE</span></div>
      <div class="nav-links">
        <a href="#metodo" class="nav-link" data-section="metodo">Método</a>
        <a href="#proceso" class="nav-link" data-section="proceso">Tu proceso</a>
        <a href="#plan" class="nav-link" data-section="plan">Plan</a>
        <a href="#plan" class="nav-cta">Quiero empezar</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="section hero">
    <div class="container-narrow center">
      <div class="hero-badge-wrap">
        <span class="badge"><i class="ti ti-award"></i> Asesoría profesional en entrenamiento · +6 años</span>
      </div>

      <h1 class="hero-title">
        Empieza a entrenar bien,<br>
        <span class="gold">sin miedo a lesionarte.</span>
      </h1>

      <p class="hero-sub">
        Nunca es tarde para cuidar tu cuerpo. Te guío desde cero con un método
        profesional que protege tus articulaciones y te da resultados que se sostienen.
      </p>

      <div class="hero-btns">
        <a href="#plan" class="btn-fire">Quiero empezar bien <i class="ti ti-arrow-up-right"></i></a>
        <a href="#proceso" class="btn-ghost">Ver cómo funciona</a>
      </div>

      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat-cell">
            <div class="stat-num">{s.num}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="scroll-hint">
      <i class="ti ti-chevron-down"></i>
    </div>
  </section>

  <!-- ENCUADRE -->
  <section class="section encuadre" id="proceso">
    <div class="container-narrow center">
      <div class="eyebrow">Por qué invertir en esto</div>
      <p class="encuadre-text">A esta etapa de tu vida, tu cuerpo no necesita el entrenamiento más intenso — necesita <span class="gold">el correcto</span>. El que te mantiene fuerte, sin dolores y con energía durante años, no durante tres meses.</p>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section class="section beneficios-bg" id="metodo">
    <div class="container">
      <div class="sec-head">
        <div class="eyebrow">Mi historia · mi método</div>
        <h2 class="sec-title">Viví lo que enseño</h2>
      </div>
      <div class="benef-grid">
        {beneficios.map((b) => (
          <div class="card fade-in">
            <div class="card-bar"></div>
            <h3 class="card-title">{b.titulo}</h3>
            <p class="card-text">{b.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRIMER AÑO -->
  <section class="section primerAÑO">
    <div class="container-mid">
      <div class="sec-head">
        <div class="eyebrow">Tu transformación</div>
        <h2 class="sec-title">De cero a avanzado en un año</h2>
      </div>
      <div class="arco">
        {etapas.map((e, i) => (
          <div class="etapa">
            <div class="etapa-icons">
              <div class={`etapa-dot ${e.fill ? "fill" : ""}`}><i class={`ti ${e.icon}`}></i></div>
              {i < 2 && <div class="etapa-line"></div>}
            </div>
            <div class="etapa-body">
              <div class="etapa-mes">{e.mes}</div>
              <h3 class="etapa-title">{e.titulo}</h3>
              <p class="etapa-text">{e.texto}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="app-box">
        <div class="app-box-txt">
          <div class="eyebrow app-eyebrow"><i class="ti ti-device-mobile"></i> Tu guía en el celular · incluida</div>
          <h3 class="app-title">La app que hace posible el viaje</h3>
          <p class="app-text">Videos y fotos de cada ejercicio, tu plan del mes y el registro de tus pesos — todo en un lugar. Sin costo extra: viene con tu asesoría.</p>
        </div>
        <div class="app-list">
          <div><i class="ti ti-player-play"></i> Videos guía de cada ejercicio</div>
          <div><i class="ti ti-barbell"></i> Registro de pesos y avances</div>
          <div><i class="ti ti-calendar-repeat"></i> Plan nuevo cada mes</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div class="eyebrow">Lo dicen ellos</div>
        <h2 class="sec-title">Empezaron como tú</h2>
      </div>
      <div class="testi-grid">
        {testimonios.map((t) => (
          <div class="card testi-card fade-in">
            <i class="ti ti-quote testi-quote"></i>
            <div class="testi-stars">★★★★★</div>
            <p class="testi-text">{t.texto}</p>
            <div class="testi-foot">
              <div class="testi-ini">{t.ini}</div>
              <div>
                <div class="testi-name">{t.nombre} <span class="gold">· {t.edad}</span></div>
                <div class="testi-time">{t.tiempo}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FRECUENCIA -->
  <section class="section encuadre">
    <div class="container-mid">
      <div class="sec-head">
        <div class="eyebrow">Frecuencia</div>
        <h2 class="sec-title">Cuánto necesitas entrenar</h2>
        <p class="sec-sub">Más días, mejores resultados. Pero incluso el mínimo genera cambios reales.</p>
      </div>
      <div class="frec-grid">
        <div class="frec-cell hl">
          <div class="frec-num sm">3</div>
          <div class="frec-label">Días mínimo<br>por semana</div>
          <div class="frec-sub">Punto de partida</div>
        </div>
        <div class="frec-cell hl">
          <div class="frec-num lg">6</div>
          <div class="frec-label">Días ideales<br>por semana</div>
          <div class="frec-sub">Máximos resultados</div>
        </div>
        <div class="frec-cell hl">
          <div class="frec-num sm">60mm</div>
          <div class="frec-label">Por sesión de<br>entrenamiento</div>
          <div class="frec-sub">Intenso y enfocado</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PLAN -->
  <section class="section plan-section" id="plan">
    <div class="container-plan">
      <div class="sec-head">
        <div class="accent center-block"></div>
        <div class="eyebrow">Un solo plan · todo incluido</div>
        <h2 class="sec-title">Tu inversión en salud</h2>
        <p class="sec-sub">Sin complicarte eligiendo. Un método profesional para llevarte de cero a fuerte, con la app incluida.</p>
      </div>

      <div class="plan-card">
        <div class="plan-tag"><i class="ti ti-star-filled"></i> ASESORÍA PROFESIONAL</div>

        <div class="plan-top">
          <div class="plan-mode"><i class="ti ti-device-laptop"></i><span>ONLINE · CON APP INCLUIDA</span></div>
          <div class="plan-price">$2,000<small> / mes</small></div>
          <div class="plan-daily"><i class="ti ti-coin"></i> menos de $67 al día por cuidar tu cuerpo</div>
        </div>

        <div class="plan-sep"></div>

        <div class="feat">
          {features.map((f) => (
            <div class="feat-row"><i class="ti ti-circle-check-filled"></i> {f}</div>
          ))}
        </div>

        <div class="certeza">
          <i class="ti ti-shield-check"></i>
          <span>Resultados que se sostienen: no una rutina de tres meses, un hábito de salud para toda la vida.</span>
        </div>

        <a href="#contacto" class="plan-btn">
          <span>Quiero empezar bien</span>
          <i class="ti ti-arrow-up-right"></i>
        </a>
        <p class="plan-note"><i class="ti ti-message-circle"></i> Primero platicamos · veo si somos buen match</p>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section class="section" id="contacto">
    <div class="container-plan">
      <div class="contacto-box">
        <div class="contacto-icon"><i class="ti ti-brand-whatsapp"></i></div>

        <div class="eyebrow">Empieza hoy</div>
        <h2 class="contacto-title">Da el primer paso</h2>
        <p class="contacto-text">
          Escríbeme por WhatsApp y platicamos tu objetivo. Veo tu punto de
          partida y te digo exactamente cómo empezamos — sin compromiso.
        </p>

        <a href={waLink} target="_blank" rel="noopener" class="wa-btn">
          <i class="ti ti-brand-whatsapp"></i>
          <span>Escríbeme por WhatsApp</span>
        </a>

        <div class="contacto-meta">
          <div class="contacto-note"><i class="ti ti-clock"></i> Respondo en menos de 24 horas</div>
          <div class="contacto-note"><i class="ti ti-lock"></i> Sin compromiso</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div>
        <div class="footer-logo">FH PERFORMANCE</div>
        <div class="footer-sub">Entrenador personal · ProGym 24/7</div>
      </div>

      <div class="social-links">
        <a href="https://instagram.com/tu_usuario" target="_blank" rel="noopener" aria-label="Instagram" class="social-btn">
          <i class="ti ti-brand-instagram"></i>
        </a>
        <a href="https://youtube.com/@tu_usuario" target="_blank" rel="noopener" aria-label="YouTube" class="social-btn">
          <i class="ti ti-brand-youtube"></i>
        </a>
        <a href="https://tiktok.com/@tu_usuario" target="_blank" rel="noopener" aria-label="TikTok" class="social-btn">
          <i class="ti ti-brand-tiktok"></i>
        </a>
        <a href="https://facebook.com/tu_usuario" target="_blank" rel="noopener" aria-label="Facebook" class="social-btn">
          <i class="ti ti-brand-facebook"></i>
        </a>
      </div>

      <div class="footer-tag">Entrenamiento que se adapta a tu vida, para siempre.</div>
    </div>
  </footer>

  <!-- SCRIPT: scroll-spy + fade-in -->
  <script>
    // Scroll-spy: resalta el link del nav según la sección visible
    const navLinks = document.querySelectorAll('.nav-link[data-section]');
    const sections = Array.from(navLinks)
      .map((link) => document.getElementById(link.getAttribute('data-section') || ''))
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length && navLinks.length) {
      const spyObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            const link = document.querySelector(`.nav-link[data-section="${id}"]`);
            if (!link) return;
            if (entry.isIntersecting) {
              navLinks.forEach((l) => l.classList.remove('active'));
              link.classList.add('active');
            }
          });
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      sections.forEach((section) => spyObserver.observe(section));
    }

    // Fade-in al hacer scroll
    const fadeEls = document.querySelectorAll('.fade-in');
    if (fadeEls.length) {
      const fadeObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              setTimeout(() => el.classList.add('visible'), i * 80);
              fadeObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
      );
      fadeEls.forEach((el) => fadeObserver.observe(el));
    }
  </script>

</Layout>

<style>
  :root {
    --bg:#07090c;
    --bg-solid:#090b0e;
    --gold:#f0c674;
    --surface:#111419;
    --border:#1e242c;
    --muted:#82899a;
    --line:#161b21;
  }

  :global(html), :global(body) {
    overflow-x: clip;
    max-width: 100%;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 78px;
  }

  /* CONTENEDORES */
  .section { padding: 80px 24px; border-bottom: 1px solid var(--line); background-color: var(--bg-solid); position: relative; }
  .container       { max-width: 1080px; margin: 0 auto; }
  .container-mid   { max-width: 820px;  margin: 0 auto; }
  .container-narrow{ max-width: 760px;  margin: 0 auto; }
  .container-plan  { max-width: 520px;  margin: 0 auto; }
  .center { text-align: center; }
  .center-block { margin-left: auto; margin-right: auto; }

  .gold { color: var(--gold); }
  .accent { width: 32px; height: 3px; background: var(--gold); margin-bottom: 16px; }
  .eyebrow { font-family:'Barlow Condensed',sans-serif; font-size:11px; letter-spacing:.18em; color:var(--gold); text-transform:uppercase; }
  .sec-head { text-align:center; margin-bottom: 40px; }
  .sec-head .eyebrow { display:block; margin-bottom: 8px; }
  .sec-title { font-family:'Bebas Neue',sans-serif; font-size:clamp(30px,4vw,42px); color:#fff; letter-spacing:.02em; line-height:1.05; text-transform:uppercase; }
  .sec-sub { font-size:13px; color:rgba(255,255,255,0.35); max-width:440px; margin:12px auto 0; line-height:1.5; }

  /* NAV */
  .nav {
    border-bottom:1px solid var(--line);
    padding:16px 24px;
    background-color: rgba(9,11,14,0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner { max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; }
  .logo { display:flex; align-items:center; gap:8px; font-weight:500; letter-spacing:.04em; font-size:15px; color:#e5e5e5; }
  .logo i { font-size:22px; color:var(--gold); }
  .nav-links { display:flex; gap:24px; align-items:center; }
  .nav-link {
    font-size:13px;
    color:var(--muted);
    text-decoration:none;
    position: relative;
    padding-bottom: 4px;
    transition: color .25s ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .25s ease;
  }
  .nav-link:hover { color: #fff; }
  .nav-link.active { color: var(--gold); }
  .nav-link.active::after { transform: scaleX(1); }
  .nav-cta { background:var(--gold); color:var(--bg); padding:8px 16px; border-radius:4px; font-weight:700; font-size:12px; text-decoration:none; }

  /* FADE-IN AL SCROLL */
  .fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .7s ease, transform .7s ease;
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-in { opacity: 1; transform: none; transition: none; }
  }

  /* ===== SECCIONES CON IMAGEN DE FONDO — negro azulado nocturno ===== */
  .hero {
    background-image: 
      radial-gradient(circle, rgba(7,9,12,0.92) 0%, rgba(7,9,12,0.75) 40%, rgba(7,9,12,0.95) 100%),
      url('/img/10.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
  }

  .beneficios-bg {
    background-image:
      linear-gradient(180deg, rgba(9,11,14,0.75) 0%, rgba(9,11,14,0.6) 40%, rgba(7,9,12,0.92) 100%),
      url('/img/6.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
  }

  .primerAÑO {
    background-image: 
      linear-gradient(180deg, rgba(7,9,12,0.9) 0%, rgba(7,9,12,0.82) 40%, rgba(7,9,12,0.94) 100%),
      url('/img/2.webp'); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
  }

  .encuadre {
    background-image: 
      linear-gradient(180deg, rgba(7,9,12,0.88) 0%, rgba(7,9,12,0.8) 40%, rgba(7,9,12,0.92) 100%),
      url('/img/13.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
  }

  .plan-section {
    background-image:
      linear-gradient(180deg, rgba(6,7,10,0.94) 0%, rgba(6,7,10,0.9) 50%, rgba(6,7,10,0.96) 100%),
      url('/img/2.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    position: relative;
  }

  @media (max-width: 768px) {
    .hero, .beneficios-bg, .primerAÑO, .encuadre, .plan-section {
      background-attachment: scroll;
    }
    .hero {
      background-image: 
        radial-gradient(circle, rgba(7,9,12,0.75) 0%, rgba(7,9,12,0.55) 40%, rgba(7,9,12,0.82) 100%),
        url('/img/1m.webp');
      background-size: auto 170%;
    }
    .beneficios-bg {
      background-image:
        linear-gradient(180deg, rgba(9,11,14,0.55) 0%, rgba(9,11,14,0.4) 40%, rgba(7,9,12,0.78) 100%),
        url('/img/2m.webp');
      background-size: auto 130%;
    }
    .primerAÑO {
      background-image: 
        linear-gradient(180deg, rgb(7, 9, 12) 0%, rgb(7, 9, 12) 40%, rgb(7, 9, 12) 100%),
        url('/img/3m.webp');
      background-size: auto 130%;
    }
    .encuadre {
      background-image: 
        linear-gradient(180deg, rgb(7, 9, 12) 0%, rgb(7, 9, 12) 40%, rgb(7, 9, 12) 100%),
        url('/img/4m.webp');
    }
    .plan-section {
      background-image:
        linear-gradient(180deg, rgba(6, 7, 10, 0.874) 0%, rgba(6, 7, 10, 0.826) 50%, rgba(6,7,10,0.72) 100%),
        url('/img/5m.webp');
      background-size: auto 130%;
    }
    .hero-title { text-shadow: 0 2px 12px rgba(0,0,0,0.8), 0 4px 30px rgba(0,0,0,0.6); }
    .hero-sub { color: rgba(255,255,255,0.75); text-shadow: 0 1px 8px rgba(0,0,0,0.6); }
    .encuadre-text { text-shadow: 0 1px 8px rgba(0,0,0,0.5); }
    .etapa-title { text-shadow: 0 1px 8px rgba(0,0,0,0.6); }
    .etapa-text { text-shadow: 0 1px 6px rgba(0,0,0,0.5); }
    .etapa-mes { text-shadow: 0 1px 6px rgba(0,0,0,0.5); }
  }

  /* HERO */
  .hero-badge-wrap { display:flex; justify-content:center; margin-bottom:24px; }
  .badge {
    display:inline-flex;
    align-items:center;
    gap:7px;
    font-family:'Barlow Condensed',sans-serif;
    font-size:11px;
    letter-spacing:.16em;
    color:var(--gold);
    background: rgba(240,198,116,0.06);
    border:1px solid rgba(240,198,116,0.35);
